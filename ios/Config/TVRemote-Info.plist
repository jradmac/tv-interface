<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>TV Remote</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>TV Remote finds and controls the TV box on your home Wi-Fi.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_tvremote._tcp</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Hold the mic button to tell the TV what to play.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Your words are turned into text and sent to the TV box.</string>
	<key>NSCameraUsageDescription</key>
	<string>Scan the code on the TV to pair this phone.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
